{
  "files.associations": {
    "*.lua": "lua"
  },
  "lua.runtime.version": "LuaJIT",
  "lua.workspace.library": [
    "${workspaceFolder}",
    "${workspaceFolder}/src"
  ],
  "lua.workspace.maxPreload": 2000,
  "lua.diagnostics.globals": [
    "love"
  ],
  "lua.telemetry.enable": false,
  "Lua.workspace.library": [
    "${3rd}/love2d/library",
    ".vscode/types"
  ],
  "Lua.runtime.version": "LuaJIT",
  "Lua.runtime.special": {
    "love.filesystem.load": "loadfile"
  },
  "Lua.workspace.checkThirdParty": "Apply",
  "Lua.diagnostics.disable": [
    "duplicate-set-field",
    "lowercase-global"
  ],
  "love2d.executablePath": "/Applications/love.app/Contents/MacOS/love"
}